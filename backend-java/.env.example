# Spring Boot Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/temple_drop?replicaSet=rs0
SESSION_SECRET=<generate-32+-char-random-secret>
CSRF_SECRET=<generate-32+-char-random-secret>
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SERVE_CLIENT_DIST=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-admin-password>
PROVIDER_API_URL=https://api.dpbossking.com/api/v1
GAME_SERVER_API_KEY=<optional-fallback-provider-api-key>
