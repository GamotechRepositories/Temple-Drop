# Server Environment Variables (Render / Production)
# Note: Render automatically sets PORT, do not hardcode it on Render Dashboard.
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/temple_drop?retryWrites=true&w=majority
USE_IN_MEMORY_MONGO=false
SESSION_SECRET=<generate-32+-char-random-secret>
CSRF_SECRET=<generate-32+-char-random-secret>
COOKIE_SECURE=true
# For single-service Render deployment (recommended), leave CORS_ORIGIN as your Render app URL:
CORS_ORIGIN=https://your-service-name.onrender.com
