# Temple Drop Environment Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For local replica set (supports transactions):
# MONGODB_URI=mongodb://127.0.0.1:27017/temple_drop?replicaSet=rs0
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/temple_drop?retryWrites=true&w=majority
# Set to true to automatically spin up an embedded in-memory MongoDB replica set (zero setup required for tests/dev):
USE_IN_MEMORY_MONGO=true

# Security & Session Secrets
SESSION_SECRET=temple_drop_jwt_and_session_secret_32_characters_min!
CSRF_SECRET=temple_drop_csrf_secret_32_chars_random_key_here!
COOKIE_SECURE=false

# CORS & Client configuration
CORS_ORIGIN=http://localhost:5173
